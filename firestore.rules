rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // By default, deny all access to all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read and update their own user profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow anyone to read the list of demo server ids
    match /demo-servers/{serverId} {
      allow read: if true;
      allow write: if false;
    }

    // Allow anyone to read server details (public statuses)
    match /servers/{serverId} {
      allow read: if true;
      allow write: if false;

      // Allow anyone to read nested server state documents (e.g. active users)
      match /details/{detailId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
